# =============================================================================
# Fintap — Server Environment Configuration TEMPLATE
# Copy this file to .env and fill in your values before starting the server.
# Never commit .env to version control.
# =============================================================================

# SERVER
NODE_ENV=development
APP_ENVIRONMENT=development
PORT=3000
# Nginx is one trusted hop in production. Keep 0 when accessing Node directly.
TRUST_PROXY_HOPS=0
# Keep false for localhost. Production must set this to true behind Nginx.
REQUIRE_HTTPS=false

# DATABASE (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Fintap
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CONNECTION_LIMIT=20

# JWT — use long random strings (32+ chars), keep secrets different from each other
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# PLATFORM ADMIN (used by seed.js on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_before_seeding
ADMIN_NAME=Platform Administrator

# ORG PAYMENT CONFIG
ORG_CALLBACK_URL=/api/payment/callback
ORG_WEBHOOK_SECRET=replace_with_a_long_random_string
ORG_PAYMENT_EXPIRY_HOURS=48
REQUIRE_WEBHOOK_SIGNATURE=true

# 1LINK / ONEBILL CONFIG
ONELINK_USERNAME=replace_with_1link_username
ONELINK_PASSWORD=replace_with_a_strong_1link_password
ONELINK_BANK_MNEMONIC=MBLINK01
# Source addresses supplied in the 1LINK kickoff (confirm for UAT/production).
ONELINK_ALLOWED_IPS=10.95.8.92,10.95.8.94

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ONELINK_RATE_LIMIT_PER_MINUTE=600
SAAS_RATE_LIMIT_PER_MINUTE=300

# CORS — set to your frontend domain in production
CORS_ORIGIN=http://localhost:8080

# CONSUMER NUMBER PREFIX (must match 1LINK biller registration)
FINTECH_PREFIX=105172

# LOGGING
LOG_LEVEL=info

# DURABLE WEBHOOK WORKER
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=10
