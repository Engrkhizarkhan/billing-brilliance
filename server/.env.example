# Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=billing_brilliance
DB_USER=root
DB_PASSWORD=your_password_here
DB_CONNECTION_LIMIT=20

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Protected Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Platform Administrator

# API Key (for ETEA payment controller)
API_KEY=your_api_key_here

# ETEA Payment Config
ETEA_CALLBACK_URL=/api/payment/callback
ETEA_WEBHOOK_SECRET=your_webhook_secret_here
ETEA_PAYMENT_EXPIRY_HOURS=48
ETEA_ALLOWED_IPS=127.0.0.1,::1
REQUIRE_WEBHOOK_SIGNATURE=true

# 1LINK / OneBill Config
ONEBILL_BASE_URL=https://sandbox.onebill.local
ONEBILL_USE_MOCK=true
ONEBILL_TIMEOUT_MS=8000
ONELINK_USERNAME=demo-user
ONELINK_PASSWORD=demo-pass
ONELINK_BANK_MNEMONIC=MBLINK01

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Consumer Number Prefix
FINTECH_PREFIX=123456

# Logging
LOG_LEVEL=info
