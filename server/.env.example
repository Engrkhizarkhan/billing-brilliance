# =============================================================================
# Payniva — Server Environment Configuration TEMPLATE
# Copy this file to .env and fill in your values before starting the server.
# Never commit .env to version control.
# =============================================================================

# SERVER
NODE_ENV=development
PORT=3000

# DATABASE (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=payniva
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CONNECTION_LIMIT=20

# JWT — use long random strings (32+ chars), keep secrets different from each other
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# PLATFORM ADMIN (used by seed.js on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_before_seeding
ADMIN_NAME=Platform Administrator

# ORG PAYMENT CONFIG
ORG_CALLBACK_URL=/api/payment/callback
ORG_WEBHOOK_SECRET=replace_with_a_long_random_string
ORG_PAYMENT_EXPIRY_HOURS=48
ORG_ALLOWED_IPS=127.0.0.1,::1
REQUIRE_WEBHOOK_SIGNATURE=true

# 1LINK / ONEBILL CONFIG
ONELINK_USERNAME=demo-user
ONELINK_PASSWORD=demo-pass
ONELINK_BANK_MNEMONIC=MBLINK01

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — set to your frontend domain in production
CORS_ORIGIN=http://localhost:8080

# CONSUMER NUMBER PREFIX (must match 1LINK biller registration)
FINTECH_PREFIX=123456

# LOGGING
LOG_LEVEL=info
