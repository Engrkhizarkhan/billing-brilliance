# Run this as a separate PM2 runtime and database. Never reuse production secrets.
# Start it with server/ecosystem.sandbox.config.cjs, which selects this file via FINTAP_ENV_FILE.
NODE_ENV=production
APP_ENVIRONMENT=sandbox
PORT=3001
REQUIRE_HTTPS=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Fintap_sandbox
DB_USER=fintap_sandbox_app
DB_PASSWORD=replace_with_a_sandbox_only_password
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_a_sandbox_only_32_plus_character_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_a_different_sandbox_only_secret
JWT_REFRESH_EXPIRES_IN=1d

ADMIN_EMAIL=sandbox-admin@example.invalid
ADMIN_PASSWORD=replace_before_first_seed
ADMIN_NAME=Sandbox Administrator
# Use values distinct from production for the PIN and encryption key.
ADMIN_ACTION_PIN=replace_with_6_digits
API_KEY_ENCRYPTION_KEY=replace_with_a_distinct_32_byte_base64_key
# This one secret must match the production API internal sandbox client.
SANDBOX_PURGE_SECRET=replace_with_the_shared_internal_control_secret

ORG_CALLBACK_URL=/api/payment/callback
ORG_WEBHOOK_SECRET=replace_with_a_sandbox_only_32_plus_character_secret
ORG_PAYMENT_EXPIRY_HOURS=48
REQUIRE_WEBHOOK_SIGNATURE=true

# 1LINK gateway routes are disabled in APP_ENVIRONMENT=sandbox.
FINTECH_PREFIX=105172
# The sandbox console is rendered by the production dashboard in the browser.
CORS_ORIGIN=https://app.fintap.pk
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
ONELINK_RATE_LIMIT_PER_MINUTE=600
SAAS_RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=info
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
